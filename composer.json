{
  "name": "ldap-account-manager/ldap-account-manager",
  "description": "LDAP Account Manager",
  "require-dev" : {
    "phpunit/phpunit" : "^10",
    "phpstan/phpstan": "^2",
    "rector/rector": "^2",
    "cyclonedx/cyclonedx-php-composer": "^6.0"
  },
  "require": {
    "ext-ldap": "*",
    "ext-json": "*",
    "ext-pdo": "*",
    "ext-xmlreader": "*",
    "ext-zip": "*",
    "ext-gd": "*",
    "ext-imagick": "*",
    "ext-gettext": "*",
    "ext-curl": "*",
    "ext-openssl": "*",
    "ext-xmlwriter": "*",
    "ext-iconv": "*"
  },
  "scripts": {
    "test": "vendor/bin/phpunit"
  },
  "license": "GPL-3.0-or-later",
  "config": {
    "platform": {
      "php": "8.2"
    },
    "allow-plugins": {
      "cyclonedx/cyclonedx-php-composer": true
    }
  }
}
