msgstr "Λίστα IP"

#: ../lib/modules/fixed_ip.inc:416
msgid "The PC name may not be longer than 20 characters."
msgstr "Το όνομα PC δεν μπορεί να είναι μακρύτερο από 20 χαρακτήρες."

#: ../lib/modules/fixed_ip.inc:419
msgid "The PC name needs to be at least 2 characters long."
msgstr "Το όνομα PC πρέπει να είναι τουλάχιστον 2 χαρακτήρες μακρύ."

#: ../lib/modules/fixed_ip.inc:422
msgid "This PC name already exists."
msgstr "Αυτό το όνομα PC υπάρχει ήδη."

#: ../lib/modules/fixed_ip.inc:425
msgid "The PC name may only contain A-Z, a-z and 0-9."
msgstr "Το όνομα PC μπορεί να περιέχει μόνο Α-Ω, α-ω, και 0-9."

#: ../lib/modules/fixed_ip.inc:428
