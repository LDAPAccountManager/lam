#: ../lib/modules/selfRegistration.inc:91
#: ../lib/modules/selfRegistration.inc:215
msgid "Please enter a valid last name."
msgstr "Παρακαλώ εισάγετε ένα έγκυρο επώνυμο."

#: ../lib/modules/selfRegistration.inc:94
msgid ""
"If you use the object class \"inetOrgPerson\" and do not provide the \"cn\" "
"attribute then LAM will set it to the user name value."
msgstr ""
"Εάν χρησιμοποιείτε την τάξη αντικειμένου \"inetOrgPerson\" και δεν παρέχετε "
"το χαρακτηριστικό \"cn\", τότε το LAM θα ​​το ορίσει στην τιμή του ονόματος "
"χρήστη."

#: ../lib/modules/selfRegistration.inc:106
msgid ""
"This is the identifier for the relative DN value. LAM will use \"uid\" by "
"default."
msgstr ""
"Αυτό είναι το αναγνωριστικό της σχετικής τιμής ΔΟ. Το LAM θα κάνει χρήση του "
"\"uid\" από προεπιλογή."

#: ../lib/modules/selfRegistration.inc:109
#: ../lib/modules/selfRegistration.inc:209
msgid "Suffix for new users"
msgstr "Κατάληξη για νέους χρήστες"

#: ../lib/modules/selfRegistration.inc:110
msgid ""
"By default, all users are created in the self-service LDAP suffix. You can "
"enter an alternative suffix here."
msgstr ""
"Από προεπιλογή, όλοι οι χρήστες δημιουργούνται στην κατάληξη "
"αυτοεξυπηρέτησης LDAP. Μπορείτε να εισάγετε μία εναλλακτική κατάληξη εδώ."

#: ../lib/modules/selfRegistration.inc:114
msgid ""
"By default, the attribute \"mail\" is used to store the email address and "
"send out user emails. You can specify a different attribute name here."
msgstr ""
"Από προεπιλογή, το χαρακτηριστικό \"mail\" χρησιμοποιείται για αποθήκευση "
"της διεύθυνσης email και αποστολή email χρηστών. Μπορείτε να δηλώσετε ένα "
"διαφορετικό όνομα χαρακτηριστικού εδώ."

#: ../lib/modules/selfRegistration.inc:125
#: ../lib/modules/selfRegistration.inc:256
msgid "Approval required"
msgstr "Απαιτείται αποδοχή"

#: ../lib/modules/selfRegistration.inc:126
msgid "If enabled the account must be approved by an administrator."
msgstr ""
"Εάν είναι ενεργοποιημένο, ο λογαριασμός πρέπει να εγκριθεί από έναν "
"διαχειριστή."

#: ../lib/modules/selfRegistration.inc:129
#: ../lib/modules/selfRegistration.inc:220 ../lib/modules.inc:1175
msgid "Set random password"
msgstr "Ορίστε τυχαίο συνθηματικό"

#: ../lib/modules/selfRegistration.inc:130
msgid ""
"This will set a random password (email wildcard "
"\"@@INFO.userPasswordClearText@@\") instead of allowing the user to choose "
"one."
msgstr ""
"Αυτό θα καθορίσει ένα τυχαίο συνθηματικό (χαρακτήρας μπαλαντέρ αλληλογραφίας "
"\"@@INFO.userPasswordClearText@@\") αντί να επιτρέπει στο χρήστη να επιλέξει "
"ένα."

#: ../lib/modules/selfRegistration.inc:140
msgid ""
"Please enter the DN and password of the administrative self registration "
"account."
msgstr ""
"Παρακαλώ εισάγετε το ΔΟ και συνθηματικό του διαχειριστή λογαριασμού "
"αυτόματης κατοχύρωσης."

#: ../lib/modules/selfRegistration.inc:141
msgid "Please enter a subject for the confirmation mails."
msgstr "Παρακαλώ εισάγετε ένα θέμα για τα mail επιβεβαίωσης."

#: ../lib/modules/selfRegistration.inc:142
msgid ""
"Please enter a text for the confirmation mails that includes the creation "
"link."
msgstr ""
"Παρακαλώ εισάγετε ένα κείμενο για τις αλληλογραφίες επιβεβαίωσης που να "
"περιέχει τον σύνδεσμο δημιουργίας."

#: ../lib/modules/selfRegistration.inc:143
msgid "Please enter a list of object classes for the new accounts."
msgstr ""
"Παρακαλώ εισάγετε μία λίστα τάξεων αντικειμένου για τους νέους λογαριασμούς."

#: ../lib/modules/selfRegistration.inc:144
msgid "Invalid format for the specification of additional attributes."
msgstr "Μη-έγκυρη μορφοποίηση για τον προσδιορισμό επιπλέον χαρακτηριστικών."

#: ../lib/modules/selfRegistration.inc:145
#: ../lib/modules/selfRegistration.inc:226
