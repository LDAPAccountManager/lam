#: ../lib/security.inc:638
#, php-format
msgid "The password must contain at least %s characters."
msgstr "Το συνθηματικό πρέπει να περιέχει τουλάχιστον %s χαρακτήρες."

#: ../lib/security.inc:642
#, php-format
msgid "The password must contain at least %s lower-case characters."
msgstr ""
"Το συνθηματικό πρέπει να περιέχει τουλάχιστον %s χαρακτήρες πεζών γραμμάτων."

#: ../lib/security.inc:645
#, php-format
msgid "The password must contain at least %s upper-case characters."
msgstr ""
"Το συνθηματικό πρέπει να περιέχει τουλάχιστον %s χαρακτήρες κεφαλαίων "
"γραμμάτων."

#: ../lib/security.inc:648
#, php-format
msgid "The password must contain at least %s numeric characters."
msgstr ""
"Το συνθηματικό πρέπει να περιέχει τουλάχιστον %s αριθμητικούς χαρακτήρες."

#: ../lib/security.inc:651
#, php-format
msgid "The password must contain at least %s symbolic characters."
msgstr "Το συνθηματικό πρέπει να περιέχει τουλάχιστον %s χαρακτήρες συμβόλων."

#: ../lib/security.inc:654
#, php-format
msgid "The password must contain at least %s different character classes."
msgstr ""
"Το συνθηματικό πρέπει να περιέχει τουλάχιστον %s διαφορετικές τάξεις "
"χαρακτήρων."

#: ../lib/security.inc:658
msgid "The password must not contain the username."
msgstr "Το συνθηματικό πρέπει να μην περιέχει το όνομα χρήστη."

#: ../lib/security.inc:661
msgid "The password must not contain parts of the username."
msgstr "Το συνθηματικό δεν πρέπει να περιέχει μέρος του ονόματος χρήστη."

#: ../lib/security.inc:664
msgid "The password must not contain parts of the account's attributes."
msgstr "Το συνθηματικό δεν πρέπει να περιέχει μέρος των ιδιοτήτων λογαριασμού."

#: ../lib/security.inc:667
msgid "The password is known to be insecure."
msgstr "Το συνθηματικό σας είναι γνωστό σαν μη-ασφαλές."

#: ../lib/security.inc:683
#, php-format
msgid ""
"The password is too weak. You have to enter at least %s lower-case "
"characters."
msgstr ""
"Το συνθηματικό είναι πολύ αδύνατο. Πρέπει να εισάγετε τουλάχιστον %s "
"χαρακτήρες πεζών γραμμάτων."

#: ../lib/security.inc:686
#, php-format
msgid ""
"The password is too weak. You have to enter at least %s upper-case "
"characters."
msgstr ""
"Το συνθηματικό είναι πολύ αδύνατο. Πρέπει να εισάγετε τουλάχιστον %s "
"χαρακτήρες κεφαλαίων γραμμάτων."

#: ../lib/security.inc:689
#, php-format
msgid ""
"The password is too weak. You have to enter at least %s numeric characters."
msgstr ""
"Το συνθηματικό είναι πολύ αδύνατο. Πρέπει να εισάγετε τουλάχιστον %s "
"αριθμητικούς χαρακτήρες."

#: ../lib/security.inc:692
#, php-format
msgid ""
"The password is too weak. You have to enter at least %s symbolic characters."
msgstr ""
"Το συνθηματικό είναι πολύ αδύνατο. Πρέπει να εισάγετε τουλάχιστον %s "
"χαρακτήρες συμβόλων."

#: ../lib/security.inc:699
#, php-format
msgid ""
"The password is too weak. It needs to match at least %s password complexity "
"rules."
msgstr ""
"Το συνθηματικό είναι πολύ αδύνατο. Πρέπει να πληρεί τουλάχιστον %s κανόνες "
"πολυπλοκότητας συνθηματικού."

#: ../lib/security.inc:702
msgid ""
"The password is too weak. You may not use the user name as part of the "
"password."
msgstr ""
"Το συνθηματικό είναι πολύ αδύνατο. Δεν πρέπει να χρησιμοποιείτε το όνομα "
"χρήστη για το συνθηματικό."

#: ../lib/security.inc:705
msgid ""
"The password is too weak. You may not use parts of the user name for the "
"password."
msgstr ""
"Το συνθηματικό είναι πολύ αδύνατο. Δεν πρέπει να χρησιμοποιείτε μέρη του "
"ονόματος χρήστη για το συνθηματικό."

#: ../lib/security.inc:708
msgid ""
"The password is too weak. You may not use parts of user attributes for the "
"password."
msgstr ""
"Το συνθηματικό είναι πολύ αδύνατο. Δεν πρέπει να χρησιμοποιείτε μέρη των "
"χαρακτηριστικών χρήστη για το συνθηματικό."

#: ../lib/security.inc:711
msgid "Your selected password is known to be insecure."
msgstr "Το επιλεγμένο συνθηματικό σας είναι γνωστό σαν μη-ασφαλές."

#: ../lib/selfService.inc:822
