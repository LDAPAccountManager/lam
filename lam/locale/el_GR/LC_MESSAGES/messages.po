msgstr "Η μάσκα υποδικτύου του δικτύου."

#: ../lib/modules/dhcp_settings.inc:195 ../lib/modules/dhcp_settings.inc:239
#: ../lib/modules/dhcp_settings.inc:674 ../lib/modules/dhcp_settings.inc:750
#: ../lib/modules/freeRadius.inc:87 ../lib/modules/freeRadius.inc:136
