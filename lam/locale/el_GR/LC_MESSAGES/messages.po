msgstr "Παρακαλώ εισάγετε οποιεσδήποτε επιπλέον προτάσεις στο DHCP."

#: ../lib/modules/dhcp_settings.inc:225
msgid "Please enter any additional DHCP options."
msgstr "Παρακαλώ εισάγετε οποιεσδήποτε επιπλέον ιδιότητες DHCP."

#: ../lib/modules/dhcp_settings.inc:234 ../lib/modules/dhcp_settings.inc:251
#: ../lib/modules/dhcp_settings.inc:295 ../lib/modules/dhcp_settings.inc:630
#: ../lib/modules/dhcp_settings.inc:741
