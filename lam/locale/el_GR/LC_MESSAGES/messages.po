msgstr "M-Κόμβος (0x04)"

#: ../lib/modules/dhcp_settings.inc:105
msgid "H-Node (0x08)"
msgstr "H-Κόμβος (0x08)"

#: ../lib/modules/dhcp_settings.inc:109
msgid "Allow"
msgstr "Επίτρεψε"

#: ../lib/modules/dhcp_settings.inc:148
msgid "The domain name of the subnet."
msgstr "Το όνομα τομέα αυτού του υποδικτύου."

#: ../lib/modules/dhcp_settings.inc:151 ../lib/modules/dhcp_settings.inc:230
#: ../lib/modules/dhcp_settings.inc:247 ../lib/modules/dhcp_settings.inc:269
