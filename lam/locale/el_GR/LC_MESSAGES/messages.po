msgstr "Η προεπιλεγμένη πύλη δεν είναι έγκυρη."

#: ../lib/modules/dhcp_settings.inc:368 ../lib/modules/dhcp_settings.inc:369
msgid "The Netbios server is invalid."
msgstr "Ο διακομιστής Netbios δεν είναι έγκυρος."

#: ../lib/modules/dhcp_settings.inc:370
msgid "The entered Netbios node type does not exist."
msgstr "Ο εισηγμένος τύπος κόμβου Netbios δεν υπάρχει."

#: ../lib/modules/dhcp_settings.inc:371
msgid "Please enter a valid option."
msgstr "Παρακαλώ εισάγετε μία έγκυρη ιδιότητα."

#: ../lib/modules/dhcp_settings.inc:372 ../lib/modules/dhcp_settings.inc:373
msgid "The maximum lease time is invalid."
