msgstr "Προσδιορίζει αν επιτρέπονται άγνωστοι πελάτες."

#: ../lib/modules/dhcp_settings.inc:207 ../lib/modules/dhcp_settings.inc:211
#: ../lib/modules/dhcp_settings.inc:242 ../lib/modules/dhcp_settings.inc:252
#: ../lib/modules/dhcp_settings.inc:301 ../lib/modules/dhcp_settings.inc:638
#: ../lib/modules/dhcp_settings.inc:742
msgid "Search domains"
msgstr "Τομείς αναζήτησης"

#: ../lib/modules/dhcp_settings.inc:208 ../lib/modules/dhcp_settings.inc:212
msgid ""
"This is a list of domain names to be used by the client to locate not-fully-"
"qualified domain names."
msgstr ""
"Αυτή είναι μία λίστα από ονόματα τομέων για χρήση από τον πελάτη για να "
"εντοπίσει όχι πλήρως πιστοποιημένα ονόματα τομέων."

#: ../lib/modules/dhcp_settings.inc:216 ../lib/modules/dhcp_settings.inc:243
#: ../lib/modules/dhcp_settings.inc:260 ../lib/modules/dhcp_settings.inc:340
#: ../lib/modules/dhcp_settings.inc:678 ../lib/modules/dhcp_settings.inc:751
msgid "Authoritative"
msgstr "Επίσημος"

#: ../lib/modules/dhcp_settings.inc:217
msgid "Authoritative servers reject requests for invalid IP addresses."
msgstr ""
"Οι επίσημοι διακομιστές απορρίπτουν αιτήματα για μη-έγκυρες διευθύνσεις IP."

#: ../lib/modules/dhcp_settings.inc:220 ../lib/modules/dhcp_settings.inc:224
#: ../lib/modules/dhcp_settings.inc:680
msgid "Extra statements"
msgstr "Επιπλέον δηλώσεις"

#: ../lib/modules/dhcp_settings.inc:221
