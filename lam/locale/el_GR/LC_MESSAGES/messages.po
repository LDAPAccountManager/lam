msgid "Minimum GID number is invalid or empty!"
msgstr "Ο ελάχιστος αριθμός GID είναι μη-έγκυρος ή κενός!"

#: ../lib/modules/posixGroup.inc:681
msgid "Maximum GID number is invalid or empty!"
msgstr "Ο μέγιστος αριθμός GID είναι μη-έγκυρος ή κενός!"

#: ../lib/modules/posixGroup.inc:682
msgid "Maximum GID number must be greater than minimum GID number!"
msgstr ""
"Ο μέγιστος αριθμός GID πρέπει να είναι μεγαλύτερος του ελάχιστου αριθμού GID!"

#: ../lib/modules/posixGroup.inc:683
msgid "GID number has to be a numeric value!"
msgstr "Ο αριθμός GID πρέπει να είναι αριθμητική τιμή!"

#: ../lib/modules/posixGroup.inc:685
msgid "Group name in use. Selected next free group name."
msgstr ""
"Το όνομα ομάδας χρησιμοποιείται ήδη.Επιλέξτε το επόμενο ελεύθερο όνομα "
"ομάδας."

#: ../lib/modules/posixGroup.inc:688
msgid "This value must be a list of user names separated by semicolons."
msgstr ""
"Αυτή τιμή πρέπει να είναι μία λίστα από ονόματα χρηστών διαχωρισμένα με \";"
"\"."

