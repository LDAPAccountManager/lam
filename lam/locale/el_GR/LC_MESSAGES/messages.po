#: ../lib/modules/customFields.inc:127
msgid ""
"This field is required. If no value is set then the validation message is "
"shown. If no validation message is set then a generic message is show."
msgstr ""
"Αυτό το πεδίο απαιτείται. Αν δεν έχει ρυθμιστεί τιμή τότε το μήνυμα επικύρωσης "
"εμφανίζεται. Αν δεν έχει ρυθμιστεί μήνυμα επικύρωσης τότε ένα γενικό μήνυμα "
"εμφανίζεται."

#: ../lib/modules/posixAccount.inc:141
msgid "This gecos value is invalid!"
msgstr "Αυτή η τιμή gecos δεν είναι έγκυρη!"

#: ../lib/modules/ipHost.inc:78
msgid "This is a comma separated list of IP addresses."
msgstr "Αυτή είναι μία λίστα διαχωρισμένων με κόμμα IP διευθύνσεων."

#: ../lib/modules/ieee802device.inc:79
msgid "This is a comma separated list of MAC addresses."
msgstr "Αυτή είναι μία λίστα διαχωρισμένων με κόμμα MAC διευθύνσεων."

#: ../lib/modules/kolabSharedFolder.inc:131 ../lib/modules/kolabUser.inc:134
