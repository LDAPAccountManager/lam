#: ../lib/modules/sambaDomain.inc:226 ../lib/modules/sambaDomain.inc:319
#: ../lib/modules/sambaDomain.inc:611
msgid "Lockout users after bad logon attempts"
msgstr "Χρήστες κλειδωμένοι απέξω μετά από κακές προσπάθειες εισόδου"

#: ../lib/modules/sambaDomain.inc:123
msgid ""
"This is the number of bad logon attempts (0 - 999) before the account is "
"deactivated. 0 means unlimited attempts."
msgstr ""
"Αυτός είναι ο αριθμός κακών προσπαθειών εισόδου (0 - 999) πριν ο λογαριασμός "
"να απενεργοποιηθεί. 0 σημαίνει απεριόριστες προσπάθειες."

#: ../lib/modules/sambaDomain.inc:135
msgid ""
"This is the time (in minutes) for which the user may not log in after the "
"account was locked. -1 means forever."
msgstr ""
"Αυτός είναι ο χρόνος (σε λεπτά) για τον οποίο ο χρήστης δεν μπορεί να κάνει "
"είσοδο αν ο λογαριασμός κλειδώθηκε. -1 σημαίνει για πάντα."

#: ../lib/modules/sambaDomain.inc:138 ../lib/modules/sambaDomain.inc:200
#: ../lib/modules/sambaDomain.inc:225 ../lib/modules/sambaDomain.inc:351
#: ../lib/modules/sambaDomain.inc:615
msgid "Reset time after lockout"
msgstr "Χρόνος επαναφοράς μετά από κλείδωμα απέξω"

#: ../lib/modules/sambaDomain.inc:139
msgid "Number of minutes after which the bad logon attempts are reset."
msgstr ""
"Αριθμός λεπτών μετά των οποίων οι κακές προσπάθειες εισόδου επαναφέρονται."

#: ../lib/modules/sambaDomain.inc:147
msgid "Workgroup"
msgstr "Ομάδα Εργασίας"

#: ../lib/modules/sambaDomain.inc:209 ../lib/modules/sambaDomain.inc:210
#: ../lib/modules/nisNetGroupUser.inc:95 ../lib/modules/nisnetgroup.inc:153
msgid "Domain name is invalid!"
msgstr "Το όνομα τομέα δεν είναι έγκυρο!"

#: ../lib/modules/sambaDomain.inc:211 ../lib/modules/sambaDomain.inc:212
msgid "Samba 3 domain SID is invalid!"
msgstr "Το SID του Samba 3 τομέα δεν είναι έγκυρο!"

#: ../lib/modules/sambaDomain.inc:213 ../lib/modules/sambaDomain.inc:214
msgid "Next RID is not a number!"
msgstr "Το επόμενο RID δεν είναι ένας αριθμός!"

#: ../lib/modules/sambaDomain.inc:215 ../lib/modules/sambaDomain.inc:216
msgid "Next user RID is not a number!"
msgstr "Το επόμενο RID χρήστη δεν είναι ένας αριθμός!"

#: ../lib/modules/sambaDomain.inc:217 ../lib/modules/sambaDomain.inc:218
msgid "Next group RID is not a number!"
msgstr "Το επόμενο RID ομάδας δεν είναι ένας αριθμός!"

#: ../lib/modules/sambaDomain.inc:219 ../lib/modules/sambaDomain.inc:220
msgid "Algorithmic RID base is not a number!"
msgstr "Το αλγοριθμικό RID βάσης δεν είναι αριθμός!"

#: ../lib/modules/sambaDomain.inc:224
msgid "Lockout duration must be are natural number."
msgstr "Η διάρκεια κλειδώματος απέξω πρέπει να είναι ένας φυσικός αριθμός."

#: ../lib/modules/sambaDomain.inc:225
msgid "Reset time after lockout must be are natural number."
msgstr ""
"Ο χρόνος επαναφοράς μετά από κλείδωμα απέξω πρέπει να είναι ένας φυσικός "
"αριθμός."

#: ../lib/modules/sambaDomain.inc:226
msgid "Lockout users after bad logon attempts must be between 0 and 999."
msgstr ""
"Οι χρήστες κλειδωμένοι απέξω μετά από κακές προσπάθειες εισόδου πρέπει να "
"είναι μεταξύ 0 και 999."

#: ../lib/modules/sambaDomain.inc:292 ../lib/modules/sambaDomain.inc:301
#: ../lib/modules/sambaDomain.inc:310 ../lib/modules/sambaDomain.inc:618
#: ../lib/modules/sambaDomain.inc:625 ../lib/modules/sambaDomain.inc:632
msgid "Off"
msgstr "Εκτός λειτουργίας"

#: ../lib/modules/sambaDomain.inc:292 ../lib/modules/sambaDomain.inc:301
#: ../lib/modules/sambaDomain.inc:310 ../lib/modules/sambaDomain.inc:620
#: ../lib/modules/sambaDomain.inc:627 ../lib/modules/sambaDomain.inc:634
msgid "On"
msgstr "Σε λειτουργία"

#: ../lib/modules/sambaDomain.inc:355
msgid "RID settings"
msgstr "Ρυθμίσεις RID"

#: ../lib/modules/imapAccess.inc:82
msgid "Address of IMAP server (e.g. mail.example.org)."
msgstr "Διεύθυνση του διακομιστή IMAP (π.χ. mail.παράδειγμα.org)."

#: ../lib/modules/imapAccess.inc:85
msgid ""
"Encryption protocol for connecting to IMAP server. LAM requires an encrypted "
"connection."
msgstr ""
"Πρωτόκολλο κρυπτογράφησης για σύνδεση με διακομιστή IMAP. Το LAM απαιτεί μία "
"κρυπτογραφημένη σύνδεση."

#: ../lib/modules/imapAccess.inc:87 ../lib/modules/imapAccess.inc:508
msgid "Validate server certificate"
msgstr "Επικύρωση πιστοποιητικού διακομιστή"

#: ../lib/modules/imapAccess.inc:88
msgid ""
"This option allows you to disable the certificate check of your IMAP server "
"certificate. Disabling the certificate check is not recommended."
msgstr ""
"Αυτή η ιδιότητα σας επιτρέπει να απενεργοποιήσετε τον έλεγχο πιστοποιητικού "
"του πιστοποιητικού σας στον διακομιστή IMAP. Απενεργοποίηση του ελέγχου "
"πιστοποιητικού δεν συνίσταται."

#: ../lib/modules/imapAccess.inc:90 ../lib/modules/imapAccess.inc:511
msgid "IMAP admin user"
msgstr "Χρήστης διαχείρισης IMAP"

#: ../lib/modules/imapAccess.inc:91
msgid ""
"The login name of your IMAP user who has rights to create/delete mailboxes."
msgstr ""
"Το όνομα εισόδου του χρήστη σας IMAP που έχει δικαιώματα δημιουργίας/"
"διαγραφής κουτιών αλληλογραφίας."

#: ../lib/modules/imapAccess.inc:91
msgid ""
"Use wildcards like $uid$ for LDAP attributes of the current LAM admin user."
msgstr ""
"Χρήση χαρακτήρων μπαλαντέρ όπως $uid$ για LDAP χαρακτηριστικά του τρέχοντα "
"χρήστη διαχείρισης LAM."

#: ../lib/modules/imapAccess.inc:93 ../lib/modules/imapAccess.inc:518
msgid "IMAP password input"
msgstr "Είσοδος κωδικού IMAP"

#: ../lib/modules/imapAccess.inc:94
msgid ""
"Choose the way how to provide the IMAP admin password. You can use the same "
"password as for the LAM login or LAM will ask you for a password when it is "
"required."
msgstr ""
"Επιλέξτε τον τρόπο με τον οποίο θα δίνετε το συνθηματικό διαχειριστή IMAP. "
"Μπορείτε να χρησιμοποιήσετε το ίδιο συνθηματικό με το συνθηματικό εισόδου "
"στο LAM ή αλλιώς το LAM θα σας ζητήσει ένα συνθηματικό όταν απαιτείται."

#: ../lib/modules/imapAccess.inc:95
msgid ""
"Storing the password in your server profile is also possible but not "
"recommended."
msgstr ""
"Η αποθήκευση του συνθηματικού στο προφίλ σας διακομιστή είναι επίσης δυνατή "
"αλλά δεν προτείνεται."

#: ../lib/modules/imapAccess.inc:98 ../lib/modules/imapAccess.inc:290
msgid "Password of IMAP admin user"
msgstr "Συνθηματικό διαχειριστή IMAP"

#: ../lib/modules/imapAccess.inc:99
msgid ""
"The password of your IMAP admin user. The login name for the IMAP admin user "
"is stored in the LAM server profile."
msgstr ""
"Το συνθηματικό του χρήστη σας IMAP. Το όνομα εισόδου για τον χρήστη IMAP "
"αποθηκεύεται στο προφίλ διακομιστή LAM."

#: ../lib/modules/imapAccess.inc:101 ../lib/modules/imapAccess.inc:530
msgid "Prefix for mailboxes"
msgstr "Πρόθεμα για κουτιά εισερχομένων"

#: ../lib/modules/imapAccess.inc:102
msgid ""
"Some IMAP servers store mailboxes with a prefix (e.g. \"user\" for Cyrus "
"which results in \"user.username\")."
msgstr ""
"Μερικοί IMAP διακομιστές αποθηκεύουν κουτιά εισερχομένων με ένα πρόθεμα "
"(π.χ. \"user\" για Cyrus το οποίο εξάγεται ως \"user.username\")."

#: ../lib/modules/imapAccess.inc:104 ../lib/modules/imapAccess.inc:527
msgid "Mail domains"
msgstr "Τομείς αλληλογραφίας"

#: ../lib/modules/imapAccess.inc:105
msgid ""
"Please enter a comma separated list of domain names (e.g. "
"\"company.com,example.com\"). LAM will only manage mailboxes from these "
"domains."
msgstr ""
"Παρακαλώ εισάγετε μία λίστα διαχωρισμένων με κόμμα ονομάτων τομέων (π.χ. "
"\"company.com,example.com\"). Το LAM θα διαχειριστεί μόνο το κουτί "
"εισερχομένων για αυτούς τους τομείς."

#: ../lib/modules/imapAccess.inc:108
msgid ""
"Please choose the attribute to get the IMAP user name. The default is "
"\"mail\" but you can also use \"uid\" or \"userPrincipalName\"."
msgstr ""
"Παρακαλώ επιλέξτε την ιδιότητα για την λήψη του ονόματος χρήστη IMAP. Η "
"προεπιλεγμένη είναι \"mail\" αλλά μπορεί να χρησιμοποιήσετε επίσης \"uid\" ή "
"\"userPrincipalName\"."

#: ../lib/modules/imapAccess.inc:111
msgid "This mailbox will be created/deleted."
msgstr "Αυτό το κουτί εισερχομένων θα δημιουργηθεί/διαγραφεί."

#: ../lib/modules/imapAccess.inc:114
msgid "Please enter the quota limit of this mailbox in kilobytes."
msgstr "Παρακαλώ εισάγετε το όριο ποσόστωσης των εισερχομένων σε kilobytes."

#: ../lib/modules/imapAccess.inc:116 ../lib/modules/imapAccess.inc:534
msgid "Path separator"
msgstr "Διαχωριστικό διαδρομής"

#: ../lib/modules/imapAccess.inc:117
msgid ""
"This is the separator for the mailbox path. Usually, this is \".\" but e.g. "
"Cyrus with \"unixhierarchysep\" will require \"/\"."
msgstr ""
"Αυτό είναι το διαχωριστικό για τη διαδρομή κουτιού εισερχομένων. Συνήθως "
"είναι \".\" αλλά π.χ. το Cyrus με \"unixhierarchysep\" θα απαιτεί \"/\"."

#: ../lib/modules/imapAccess.inc:119 ../lib/modules/imapAccess.inc:531
msgid "Initial folders"
msgstr "Αρχικοί φάκελοι"

#: ../lib/modules/imapAccess.inc:120
msgid ""
"Use this to provide a list of folders (e.g. Trash) to add for new accounts."
msgstr ""
"Χρήση αυτού για να δώσετε μία λίστα φακέλων για προσθήκη (π.χ. Κάδος "
"Απορριμάτων) για νέους λογαριασμούς."

#: ../lib/modules/imapAccess.inc:122 ../lib/modules/imapAccess.inc:270
#: ../lib/modules/imapAccess.inc:770
msgid "Create mailbox"
msgstr "Δημιουργία κουτιού εισερχομένων αλληλογραφίας"

#: ../lib/modules/imapAccess.inc:123
msgid "Set to \"true\" to create the mailbox."
msgstr "Ορίστε σαν \"αληθές\" για τη δημιουργία κουτιού εισερχομένων."

#: ../lib/modules/imapAccess.inc:154
msgid "Please enter a correct list of valid mail domains."
msgstr "Παρακαλώ εισάγετε μία σωστή λίστα έγκυρων τομέων αλληλογραφίας."

#: ../lib/modules/imapAccess.inc:155
msgid "The IMAP admin password is empty."
msgstr "Το συνθηματικό διαχειριστή IMAP είναι κενό."

#: ../lib/modules/imapAccess.inc:156
msgid "Unable to change ACL on IMAP server for mailbox deletion."
msgstr ""
"Αδυναμία αλλαγής ACL στον IMAP διακομιστή για διαγραφή κουτιού εισερχομένων."

#: ../lib/modules/imapAccess.inc:157
msgid "Unable to delete mailbox from IMAP server."
msgstr "Αδυναμία διαγραφής κουτιού εισερχομένων στον διακομιστή IMAP."

#: ../lib/modules/imapAccess.inc:158
msgid "Unable to create mailbox on IMAP server."
msgstr "Αδυναμία δημιουργίας κουτιού εισερχομένων στον διακομιστή IMAP."

#: ../lib/modules/imapAccess.inc:159
msgid "Unable to locate mailbox on IMAP."
msgstr "Αδυναμία εντοπισμού κουτιού εισερχομένων στον IMAP."

#: ../lib/modules/imapAccess.inc:160
msgid "Your IMAP domains and email address domain do not match."
msgstr ""
"Οι τομείς σας IMAP και οι διευθύνσεις τομέων αλληλογραφίας δεν ταιριάζουν."

#: ../lib/modules/imapAccess.inc:161
msgid "Invalid password for IMAP admin or other problem occurred."
msgstr ""
"Μη-έγκυρο συνθηματικό για τον διαχειριστή IMAP ή προέκυψε άλλο πρόβλημα."

#: ../lib/modules/imapAccess.inc:162
msgid "Your LAM login password was not accepted by the IMAP server."
msgstr "Το LAM συνθηματικό σας εισόδου δεν έγινε δεκτό από το διακομιστή IMAP."

#: ../lib/modules/imapAccess.inc:163
msgid "Cannot update quota."
msgstr "Δεν γίνεται η αναβάθμιση της ποσόστωσης."

#: ../lib/modules/imapAccess.inc:164 ../lib/modules/imapAccess.inc:165
msgid "Wrong quota format. Quota must be numeric."
msgstr "Λάθος μορφοποίηση ποσόστωσης. Η ποσόστωση πρέπει να είναι αριθμητική."

#: ../lib/modules/imapAccess.inc:166
msgid "Cannot read quota."
msgstr "Δεν μπορεί να διαβαστεί η ποσόστωση."

#: ../lib/modules/imapAccess.inc:209 ../lib/modules/kolabUser.inc:245
#, php-format
msgid "Please enter an email address on this page: %s"
msgstr "Παρακαλώ εισάγετε μία διεύθυνση αλληλογραφίας σε αυτή την σελίδα: %s"

#: ../lib/modules/imapAccess.inc:257
msgid "Delete mailbox"
msgstr "Διαγραφή κουτιού εισερχομένων"

#: ../lib/modules/imapAccess.inc:262
msgid "Mailbox does not exist on IMAP server."
msgstr "Δεν υπάρχει κουτί εισερχομένων αλληλογραφίας στο διακομιστή IMAP."

#: ../lib/modules/imapAccess.inc:323
msgid "Current usage (kB)"
msgstr "Τρέχουσα χρήση (kB)"

#: ../lib/modules/imapAccess.inc:325 ../lib/modules/imapAccess.inc:334
#: ../lib/modules/imapAccess.inc:778
msgid "Quota limit (kB)"
msgstr "Όριο ποσόστωσης (kB)"

#: ../lib/modules/imapAccess.inc:328 ../lib/modules/imapAccess.inc:337
msgid "Update quota"
msgstr "Αναβάθμιση ποσόστωσης"

#: ../lib/modules/imapAccess.inc:515
msgid "LAM user password"
msgstr "Συνθηματικό χρήστη LAM"

#: ../lib/modules/imapAccess.inc:516
msgid "Ask"
msgstr "Ρώτα"

#: ../lib/modules/imapAccess.inc:689
msgid "Unable to connect to IMAP server."
msgstr "Αδυναμία σύνδεσης στον διακομιστή IMAP."

#: ../lib/modules/nisMailAlias.inc:77
msgid "Mails to this name are forwarded to the recipients."
msgstr "Μηνύματα αλληλογραφίας σε αυτό το όνομα προωθούνται στους παραλήπτες."

#: ../lib/modules/nisMailAlias.inc:80 ../lib/modules/nisMailAlias.inc:172
#: ../lib/modules/nisMailAlias.inc:194
msgid "Recipients"
msgstr "Παραλήπτες"

#: ../lib/modules/nisMailAlias.inc:81
msgid "Please enter the recipients for this alias."
msgstr "Παρακαλώ εισάγετε τους αποδέκτες για αυτό ψευδώνυμο."

#: ../lib/modules/nisMailAlias.inc:84 ../lib/modules/nisMailAlias.inc:103
#: ../lib/modules/nisMailAlias.inc:111 ../lib/modules/nisMailAlias.inc:453
#: ../lib/modules/nisMailAlias.inc:504
msgid "Recipient list"
msgstr "Λίστα παραληπτών"

#: ../lib/modules/nisMailAlias.inc:85
msgid "This is a comma separated list of recipients."
msgstr "Αυτή είναι μία λίστα διαχωρισμένων με κόμμα παραληπτών."

#: ../lib/modules/nisMailAlias.inc:120 ../lib/modules/nisMailAlias.inc:121
msgid "Alias is empty or invalid!"
msgstr "Το ψευδώνυμο είναι κενό ή δεν είναι έγκυρο!"

#: ../lib/modules/nisMailAlias.inc:122 ../lib/modules/nisMailAlias.inc:123
msgid "Recipient is invalid!"
msgstr "Ο παραλήπτης δεν είναι έγκυρος!"

#: ../lib/modules/nisMailAlias.inc:169 ../lib/modules/nisMailAliasUser.inc:327
msgid "Recipient"
msgstr "Παραλήπτης"

#: ../lib/modules/nisMailAlias.inc:185 ../lib/modules/nisMailAlias.inc:208
msgid "Select mail"
msgstr "Επιλογή αλληλογραφίας"

#: ../lib/modules/nisMailAlias.inc:186 ../lib/modules/nisMailAlias.inc:209
#: ../lib/modules/nisnetgroup.inc:225 ../lib/modules/nisnetgroup.inc:265
msgid "Select user"
msgstr "Επιλογή χρήστη"

#: ../lib/modules/nisMailAlias.inc:199
msgid "New recipient"
msgstr "Νέος παραλήπτης"

#: ../lib/modules/nisNetGroupHost.inc:62 ../lib/modules/nisNetGroupUser.inc:83
msgid "Memberships"
msgstr "Ιδιότητες μέλους"

#: ../lib/modules/nisNetGroupUser.inc:70 ../lib/modules/nisNetGroupUser.inc:72
#: ../lib/modules/nisNetGroupUser.inc:76
msgid "NIS net groups"
msgstr "Ομάδες δικτύου NIS"

#: ../lib/modules/nisNetGroupUser.inc:77
msgid ""
"Here you can enter a list of net groups. Group blocks are separated by comma "
"in format GROUP#HOST#DOMAIN. Host and domain are optional."
msgstr ""
"Εδώ μπορείτε να βάλετε μία λίστα από δικτυακές ομάδες. Τα μπλοκ ομάδων "
"διαχωρίζονται με κόμμα στη μορφή ΟΜΑΔΑ#ΥΠΟΛΟΓΙΣΤΗΣ#ΤΟΜΕΑΣ.Τα υπολογιστής και "
"τομέας είναι προαιρετικά."

#: ../lib/modules/nisNetGroupUser.inc:94 ../lib/modules/nisnetgroup.inc:152
#: ../lib/modules/posixAccount.inc:131 ../lib/modules/posixAccount.inc:135
#: ../lib/modules/windowsHost.inc:152 ../lib/modules/windowsHost.inc:153
msgid ""
"Host name contains invalid characters. Valid characters are: a-z, A-Z, 0-9 "
"and .-_ !"
msgstr ""
"Το όνομα υπολογιστή περιέχει μη έγκυρους χαρακτήρες. Έγκυροι είναι οι "
"χαρακτήρες: α-ω, Α-Ω, 0-9 και .-_ !"

#: ../lib/modules/nisnetgroup.inc:66
msgid "NIS net group"
msgstr "Ομάδα δικτύου NIS"

#: ../lib/modules/nisnetgroup.inc:90 ../lib/modules/nisnetgroup.inc:125
#: ../lib/modules/nisnetgroup.inc:140 ../lib/modules/nisnetgroup.inc:189
#: ../lib/modules/nisnetgroup.inc:377 ../lib/modules/nisnetgroup.inc:535
#: ../lib/modules/nisnetgroup.inc:621
msgid "Subgroups"
msgstr "Υποομάδες"

#: ../lib/modules/nisnetgroup.inc:91
msgid ""
"Here you can specify subgroups which are included in this NIS netgroup. All "
"members of the subgroups will be treated as members of this group."
msgstr ""
"Εδώ μπορείτε να καθορίσετε υποομάδες που περιλαμβάνονται σε αυτήν την ομάδα "
"δικτύου NIS. Όλα τα μέλη των υποομάδων θα αντιμετωπίζονται ως μέλη αυτής της "
"ομάδας."

#: ../lib/modules/nisnetgroup.inc:95 ../lib/modules/nisnetgroup.inc:99
msgid ""
"These entries specify the members of the netgroup. You can limit the set to "
"a host name, a user name, a domain name or any combination of them."
msgstr ""
"Αυτές οι εγγραφές προσδιορίζουν τα μέλη του netgroup. Μπορείτε να "
"περιορίσετε το σύνολο σε ένα όνομα υπολογιστή, ένα όνομα χρήστη, ένα όνομα "
"τομέα ή κάθε συνδυασμό τον παραπάνω."

#: ../lib/modules/nisnetgroup.inc:100
msgid ""
"For the upload please specify the entries in the format \"(HOST,USER,DOMAIN)"
"\". Multiple entries are separated by semicolon."
msgstr ""
"Για ανέβασμα παρακαλώ προσδιορίστε τις εγγραφές με μορφοποίηση "
"\"(HOST,USER,DOMAIN)\". Πολλαπλές εγγραφές χωρίζονται με \";\"."

#: ../lib/modules/nisnetgroup.inc:119 ../lib/modules/posixGroup.inc:77
#: ../lib/modules/posixGroup.inc:1387
msgid "Group description"
msgstr "Περιγραφή ομάδας"

#: ../lib/modules/nisnetgroup.inc:133
msgid "(host1,user1,example.com);(host2,user2,example.com)"
msgstr ""
"(υπολογιστής1,χρήστης1,παράδειγμα.com);(υπολογιστής2,χρήστης2,παράδειγμα.com)"

#: ../lib/modules/nisnetgroup.inc:186
msgid "Edit subgroups"
msgstr "Επεξεργασία υπο-ομάδων"

#: ../lib/modules/nisnetgroup.inc:216 ../lib/modules/nisnetgroup.inc:256
msgid "Select host"
msgstr "Επιλογή υπολογιστή"

#: ../lib/modules/pykotaPrinter.inc:96
msgid ""
"Printer name of the printer which should be created. Valid characters are: a-"
"z, A-Z, 0-9 and .-_ ."
msgstr ""
"Όνομα εκτυπωτή του εκτυπωτή που θα πρέπει να δημιουργηθεί. Έγκυροι "
"χαρακτήρες είναι: α-ω, Α-Ω, 0-9 και .-_ ."

#: ../lib/modules/pykotaPrinter.inc:100
msgid "Printer description."
msgstr "Περιγραφή εκτυπωτή."

#: ../lib/modules/pykotaPrinter.inc:103 ../lib/modules/pykotaPrinter.inc:135
#: ../lib/modules/pykotaPrinter.inc:159 ../lib/modules/pykotaPrinter.inc:195
#: ../lib/modules/pykotaPrinter.inc:213 ../lib/modules/pykotaPrinter.inc:241
#: ../lib/modules/pykotaPrinter.inc:572 ../lib/modules/pykotaPrinter.inc:663
msgid "Maximum job size"
msgstr "Μέγιστο μέγεθος εργασίας"

#: ../lib/modules/pykotaPrinter.inc:104
msgid ""
"The maximum number of pages per job allowed on the printer. 0 means "
"unlimited."
msgstr ""
"Ο μέγιστος αριθμός των σελίδων ανά επιτρεπόμενη εργασία εκτύπωσης. 0 "
"σημαίνει χωρίς περιορισμούς."

#: ../lib/modules/pykotaPrinter.inc:107 ../lib/modules/pykotaPrinter.inc:166
#: ../lib/modules/pykotaPrinter.inc:196 ../lib/modules/pykotaPrinter.inc:251
#: ../lib/modules/pykotaPrinter.inc:581 ../lib/modules/pykotaPrinter.inc:664
msgid "Passthrough"
msgstr "Διέλευση"

#: ../lib/modules/pykotaPrinter.inc:108
msgid ""
"In passthrough mode, users are allowed to print without any impact on their "
"quota or account balance."
