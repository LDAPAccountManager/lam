#: ../lib/modules/dhcp_settings.inc:378 ../lib/modules/dhcp_settings.inc:379
msgid ""
"The domain name includes invalid characters. Valid characters are A-Z, a-z, "
"0-9, \".\", \"_\",\"-\"."
