msgid ""
"Please enter the date and time format. Example formats are \"Y-m-d H:i:s\" or "
"\"d.m.Y H:i:s\"."
msgstr ""
"Voer het datum- en tijdformaat in. Voorbeeldformaten zijn \"Y-m-d H:i:s\" of "
"\"d.m.Y H:i:s\"."

