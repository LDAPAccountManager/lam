#: ../lib/modules/guacamole.inc:49 ../lib/modules/guacamole.inc:54
#: ../lib/modules/guacamole.inc:60
msgid "This is a list of key=value pairs to configure the selected protocol."
msgstr ""
"To jest lista par klucz=wartość do skonfigurowania wybranego protokołu."

#: ../lib/modules/guacamole.inc:55
msgid "The entries are separated by newlines."
msgstr "Wpisy są oddzielone nowym wierszem."

#: ../lib/modules/guacamole.inc:92
msgid "Please enter \"rdp\", \"vnc\", \"ssh\", \"telnet\" or \"kubernetes\"."
msgstr "Wpisz „rdp”, „vnc”, „ssh”, „telnet” lub „kubernetes”."

#: ../lib/modules/requestAccess.inc:48 ../lib/modules/requestAccess.inc:142
#: ../lib/modules/requestAccess.inc:475 ../lib/persistence.inc:432
msgid "Request access"
msgstr "Poproś o dostęp"

#: ../lib/modules/requestAccess.inc:52 ../lib/modules/requestAccess.inc:275
msgid "Enable request access"
msgstr "Włącz prośbę o dostęp"

#: ../lib/modules/requestAccess.inc:53
msgid ""
"This enables the request access feature to allow user to request access to "
"group of names."
msgstr ""
"Umożliwia to funkcji żądania dostępu, aby umożliwić użytkownikowi żądanie "
"dostępu do grupy nazw."

#: ../lib/modules/requestAccess.inc:56 ../lib/modules/requestAccess.inc:153
#: ../lib/modules/requestAccess.inc:284
msgid "LDAP suffix of groups"
msgstr "Sufiks LDAP dla grup"

#: ../lib/modules/requestAccess.inc:57
msgid ""
"The groups will be searched in this LDAP suffix. Group of names and group of "
"unique names are supported."
msgstr ""
"Grupy zostaną przeszukane według tego sufiksu LDAP. Obsługiwana jest grupa "
"nazw i grupa unikatowych nazw."

#: ../lib/modules/requestAccess.inc:60 ../lib/modules/requestAccess.inc:285
msgid "LDAP filter for groups"
msgstr "Filtr LDAP dla grup"

#: ../lib/modules/requestAccess.inc:61
msgid ""
"Here you can provide an optional LDAP filter to limit the groups to display."
msgstr ""
"W tym miejscu możesz podać opcjonalny filtr LDAP, aby ograniczyć "
"wyświetlenie grup."

#: ../lib/modules/requestAccess.inc:64 ../lib/modules/requestAccess.inc:287
msgid "Allow requests for group ownership"
msgstr "Zezwalaj na żądania dotyczące własności grupy"

#: ../lib/modules/requestAccess.inc:65
msgid "Activate this to allow users to request getting an owner of a group."
msgstr ""
"Aktywuj tę opcję, aby umożliwić użytkownikom żądanie ustalenia właściciela "
"grupy."

#: ../lib/modules/requestAccess.inc:68 ../lib/modules/requestAccess.inc:157
#: ../lib/modules/requestAccess.inc:296
msgid "Approver group DN"
msgstr "DN grupy osób zatwierdzających"

#: ../lib/modules/requestAccess.inc:69
msgid ""
"The members of this group can perform the final approval. Leave empty to "
"reduce to owner approval."
msgstr ""
"Członkowie tej grupy mogą dokonać finalnego zatwierdzenia. Pozostaw puste, "
"aby skrócić do zatwierdzenia przez właściciela."

#: ../lib/modules/requestAccess.inc:72 ../lib/modules/requestAccess.inc:155
#: ../lib/modules/requestAccess.inc:289
msgid "Subject for owner email"
msgstr "Temat wiadomości e-mail właściciela"

#: ../lib/modules/requestAccess.inc:73
msgid "Please enter the subject of the email to the group owners."
msgstr "Podaj temat wiadomości e-mail do właścicieli grupy."

#: ../lib/modules/requestAccess.inc:76 ../lib/modules/requestAccess.inc:156
#: ../lib/modules/requestAccess.inc:292
msgid "Text for owner email"
msgstr "Tekst adresu e-mail właściciela"

#: ../lib/modules/requestAccess.inc:77
msgid "The body text of the owner's email."
msgstr "Treść wiadomości e-mail od właściciela."

#: ../lib/modules/requestAccess.inc:78 ../lib/modules/requestAccess.inc:87
#: ../lib/modules/requestAccess.inc:96 ../lib/modules/requestAccess.inc:105
msgid "Please see the manual for a list of wildcards."
msgstr "Zapoznaj się z instrukcją, aby znaleźć listę symboli wieloznacznych."

#: ../lib/modules/requestAccess.inc:81 ../lib/modules/requestAccess.inc:99
#: ../lib/modules/requestAccess.inc:297
msgid "Subject for approver email"
msgstr "Temat wiadomości e-mail osoby zatwierdzającej"

#: ../lib/modules/requestAccess.inc:82
msgid "Please enter the subject of the email to the approvers."
msgstr "Podaj temat wiadomości e-mail do osób zatwierdzających."

#: ../lib/modules/requestAccess.inc:85 ../lib/modules/requestAccess.inc:299
msgid "Text for approver email"
msgstr "Tekst wiadomości e-mail do osoby zatwierdzającej"

#: ../lib/modules/requestAccess.inc:86
msgid "The body text of the approver's email."
msgstr "Treść wiadomości e-mail osoby zatwierdzającej."

#: ../lib/modules/requestAccess.inc:90 ../lib/modules/requestAccess.inc:302
msgid "Email subject for approved requests"
msgstr "Temat wiadomości e-mail dla zatwierdzonych próśb"

#: ../lib/modules/requestAccess.inc:91
msgid ""
"Please enter the subject of the email to the requester in case the request "
"was approved."
msgstr ""
"Podaj temat wiadomości e-mail do osoby zgłaszającej prośbę, jeśli prośba "
"została zatwierdzona."

#: ../lib/modules/requestAccess.inc:94 ../lib/modules/requestAccess.inc:305
msgid "Email text for approved requests"
msgstr "Tekst wiadomości e-mail dla zatwierdzonych próśb"

#: ../lib/modules/requestAccess.inc:95
msgid ""
"The body text of the requester's email in case the request was approved."
msgstr ""
"Treść wiadomości e-mail osoby zgłaszającej w przypadku, gdy prośba została "
"zatwierdzona."

#: ../lib/modules/requestAccess.inc:100
msgid ""
"Please enter the subject of the email to the requester in case the request "
"was denied."
msgstr ""
"Podaj temat wiadomości e-mail do osoby zgłaszającej prośbę, jeśli prośba "
"została odrzucona."

#: ../lib/modules/requestAccess.inc:103 ../lib/modules/requestAccess.inc:309
msgid "Email subject for denied requests"
msgstr "Temat wiadomości e-mail dla odrzuconych próśb"

#: ../lib/modules/requestAccess.inc:104
msgid "The body text of the requester's email in case the request was denied."
msgstr ""
"Treść wiadomości e-mail osoby składającej wniosek w przypadku odrzucenia "
"prośby."

#: ../lib/modules/requestAccess.inc:112 ../lib/modules/requestAccess.inc:190
#: ../lib/modules/requestAccess.inc:230
msgid "History retention period"
msgstr "Okres przechowywania historii"

#: ../lib/modules/requestAccess.inc:113
msgid ""
"Specifies how many days history entries are kept before they are deleted."
msgstr ""
"Określa liczbę dni przechowywania wpisów historii przed ich usunięciem."

#: ../lib/modules/requestAccess.inc:116 ../lib/modules/requestAccess.inc:188
#: ../lib/modules/requestAccess.inc:226
msgid "Request expiration period"
msgstr "Okres wygaśnięcia żądania"

#: ../lib/modules/requestAccess.inc:117
msgid "Specifies how many days open requests are kept before they are deleted."
msgstr ""
"Określa liczbę dni, przez które otwarte wnioski są przechowywane, zanim "
"zostaną usunięte."

#: ../lib/modules/requestAccess.inc:120 ../lib/modules/requestAccess.inc:159
#: ../lib/modules/requestAccess.inc:316
msgid "Membership revocation time"
msgstr "Czas odwołania członkostwa"

#: ../lib/modules/requestAccess.inc:121
msgid ""
"Specifies the number of days after a membership is removed (e.g. \"365\")."
msgstr "Określa liczbę dni po których członkostwo jest usuniętę (np. „365”)."

#: ../lib/modules/requestAccess.inc:125
msgid ""
"Please enter the LDAP DN that should be used to remove expired memberships."
msgstr ""
"Proszę wprowadzić nazwę LDAP DN, która ma zostać użyta do usuwania wygasłych "
"członkostw."

#: ../lib/modules/requestAccess.inc:132 ../lib/modules/requestAccess.inc:318
msgid "Allow custom expiration time"
msgstr "Zezwalaj na niestandardowy czas wygaśnięcia"

#: ../lib/modules/requestAccess.inc:133
msgid "Allows the owners to set a custom or no expiration time."
msgstr ""
"Umożliwia właścicielom ustawienie niestandardowego czasu wygaśnięcia lub "
"jego brak."

#: ../lib/modules/requestAccess.inc:136 ../lib/modules/requestAccess.inc:154
#: ../lib/modules/requestAccess.inc:286
msgid "Additional owners group DN"
msgstr "Dodatkowa grupa właścicieli DN"

#: ../lib/modules/requestAccess.inc:137
msgid ""
"By default, first approval is given by group owners (\"owner\" or "
"\"managedBy\" attribute). If you enter a group DN here then members of this "
"group can additionally approve on behalf of the owners."
msgstr ""
"Domyślnie, pierwsza zgoda jest udzielana przez właścicieli grup (atrybut "
"„owner” lub „managedBy”). Jeśli wprowadzisz tutaj nazwę grupy DN, członkowie "
"tej grupy mogą dodatkowo zatwierdzać w imieniu właścicieli."

#: ../lib/modules/requestAccess.inc:143
msgid "Owner view"
msgstr "Widok właściciela"

#: ../lib/modules/requestAccess.inc:144
msgid "Approver view"
msgstr "Widok osoby zatwierdzającej"

#: ../lib/modules/requestAccess.inc:145 ../lib/modules/requestAccess.inc:537
msgid "History of own requests"
msgstr "Historia własnych żądań"

#: ../lib/modules/requestAccess.inc:146 ../lib/modules/requestAccess.inc:871
msgid "History of requests"
msgstr "Historia żądań"

#: ../lib/modules/requestAccess.inc:147 ../lib/modules/requestAccess.inc:1152
#: ../lib/modules/requestAccess.inc:1308 ../lib/persistence.inc:440
msgid "Revocation information"
msgstr "Informacje o odwołaniu"

#: ../lib/modules/requestAccess.inc:158
msgid ""
"Please enter the DN and password of the administrative request access "
"account."
msgstr "Proszę wprowadzić DN i hasło konta dostępu administracyjnego."

#: ../lib/modules/requestAccess.inc:312
msgid "Email text for denied requests"
msgstr "Tekst wiadomości e-mail dla odrzuconych próśb"

