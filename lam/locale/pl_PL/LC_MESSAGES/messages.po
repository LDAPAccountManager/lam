msgid ""
"Please enter the date format. Example formats are \"Y-m-d\" or \"d.m.Y\"."
msgstr ""
"Wprowadź format daty. Przykładowe formaty to „rr-mm-dd” lub „dd.mm.rr”."

#: ../lib/modules/customFields.inc:135
msgid ""
"Please enter the date and time format. Example formats are \"Y-m-d H:i:s\" "
"or \"d.m.Y H:i:s\"."
msgstr ""
"Wprowadź format daty i godziny. Przykładowe formaty to „Y-m-d H:i:s” lub „d."
"m.Y H:i:s”."

#: ../lib/modules/customFields.inc:138 ../lib/modules/customFields.inc:238
#: ../lib/modules/customFields.inc:6131
msgid "Display in local time"
msgstr "Wyświetl w czasie lokalnym"

#: ../lib/modules/customFields.inc:139
msgid "This will display the time in the selected time zone instead of UTC."
msgstr ""
"Spowoduje to wyświetlenie czasu w wybranej strefie czasowej zamiast UTC."

#: ../lib/modules/customFields.inc:142 ../lib/modules/customFields.inc:2503
