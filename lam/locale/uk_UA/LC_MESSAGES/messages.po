#: ../lib/modules/posixGroup.inc:472
msgid ""
"The filter can be any regular expression, e.g. \".*\" = any characters, "
"\"^\" = line start, \"$\" = line end."
msgstr "Фільтр повинен бути регулярним виразом, наприклад,  \"*\" = будь-який символ, \"^\" = початок рядка, \"$\" = кінець рядка."

