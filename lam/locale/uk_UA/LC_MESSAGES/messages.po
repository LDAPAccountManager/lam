msgstr "Якщо встановлено, то користувач зобов’язаний увійти в систему для зміни пароля."

#: ../lib/modules/sambaDomain.inc:120 ../lib/modules/sambaDomain.inc:200
#: ../lib/modules/sambaDomain.inc:308 ../lib/modules/sambaDomain.inc:640
msgid "Disconnect users outside logon hours"
msgstr "Відключення користувачів в недозволений час для входу"

#: ../lib/modules/sambaDomain.inc:121
