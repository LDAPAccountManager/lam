msgstr "Наступний RID користувача не число!"

#: ../lib/modules/sambaDomain.inc:223 ../lib/modules/sambaDomain.inc:224
msgid "Next group RID is not a number!"
msgstr "Наступний RID групи не число!"

#: ../lib/modules/sambaDomain.inc:225 ../lib/modules/sambaDomain.inc:226
msgid "Algorithmic RID base is not a number!"
msgstr "Алгоритм RID бази не число!"

#: ../lib/modules/sambaDomain.inc:230
msgid "Lockout duration must be are natural number."
msgstr "Термін блокування повинен бути цілим числом."

#: ../lib/modules/sambaDomain.inc:231
msgid "Reset time after lockout must be are natural number."
msgstr "Час скидання після блокування повинно бути натуральним числом."

#: ../lib/modules/sambaDomain.inc:232
msgid "Lockout users after bad logon attempts must be between 0 and 999."
msgstr "Блокування користувачів після невдалих спроб входу повинна бути між 0 та 999."

