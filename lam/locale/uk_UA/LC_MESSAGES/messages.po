#: ../lib/modules/customFields.inc:86 ../lib/modules/customFields.inc:643
#: ../lib/modules/customFields.inc:659
msgid "Create new group"
msgstr "Створити нову групу"

#: ../lib/modules/customFields.inc:87
msgid ""
"Creates a new group for the given account type. Groups build a container for"
" object classes and attributes."
msgstr "Створює нову групу для цього типу акаунта. З груп складається контейнер для класів  об'єктів та атрибутів."

#: ../lib/modules/customFields.inc:91
msgid "Please enter an alias for this group."
msgstr "Будь ласка, вкажіть псевдонім для цієї групи."

#: ../lib/modules/customFields.inc:95
msgid ""
"Here you can enter one or more object classes (separated by comma). This "
"will allow you to add/remove the group's attributes including their object "
"classes."
msgstr "Тут ви можете вказати один або кілька класів об’єктів (розділені комами). Це дозволить вам додавати / видаляти атрибути групи, включно з їх класами об’єктів."

#: ../lib/modules/customFields.inc:99
msgid "Please enter a descriptive label for this field."
msgstr "Будь ласка, вкажіть опис для цього поля."

#: ../lib/modules/customFields.inc:103
msgid "Please enter the LDAP attribute name for this field."
msgstr "Будь ласка, вкажіть назву атрибута LDAP для цього поля."

#: ../lib/modules/customFields.inc:106 ../lib/modules/customFields.inc:2158
msgid "Help text"
msgstr "Допомога"

#: ../lib/modules/customFields.inc:107
msgid "Here you can set a describing text for your custom field."
msgstr "Тут ви можете встановити описовий текст для створюваного поля."

#: ../lib/modules/customFields.inc:111
msgid "Please select the field type (e.g. text field)."
msgstr "Будь ласка, виберіть тип поля (наприклад, текстове)."

#: ../lib/modules/customFields.inc:115
msgid ""
"Read-only fields cannot be changed by the user. Use this if you want to show"
" an attribute just for information."
msgstr "Поля тільки для читання не можуть змінюватися користувачами. Використовуйте це, якщо ви хочете показати атрибут тільки для інформації."

#: ../lib/modules/customFields.inc:118 ../lib/modules/customFields.inc:2527
#: ../lib/modules/customFields.inc:5536
msgid "Required"
msgstr "обов’язкове"

#: ../lib/modules/customFields.inc:119
msgid ""
"This field is required. If no value is set then the validation message is "
"shown. If no validation message is set then a generic message is show."
msgstr "Це поле є обов'язковим. Якщо значення не встановлено, то повідомлення перевірки показуються. Якщо повідомлення про перевірку не встановлено, то показується загальне повідомлення."

#: ../lib/modules/customFields.inc:122 ../lib/modules/customFields.inc:126
#: ../lib/modules/customFields.inc:2488 ../lib/modules/customFields.inc:2553
msgid "Date format"
msgstr "Формат дати"

#: ../lib/modules/customFields.inc:123
msgid "Please enter the date format. Example formats are \"Y-m-d\" or \"d.m.Y\"."
msgstr "Вкажіть формат дати. Наприклад, \"Y-m-d\" or \"d.m.Y\"."

#: ../lib/modules/customFields.inc:127
msgid ""
"Please enter the date and time format. Example formats are \"Y-m-d H:i:s\" "
"or \"d.m.Y H:i:s\"."
msgstr "Введіть формат дати та часу. Наприклад, формат може бути \"Y-m-d H:i:s\" або \"d.m.Y H:i:s\"."

#: ../lib/modules/customFields.inc:130 ../lib/modules/customFields.inc:230
#: ../lib/modules/customFields.inc:6243
msgid "Display in local time"
msgstr "Показати в місцевому часі"

#: ../lib/modules/customFields.inc:131
msgid "This will display the time in the selected time zone instead of UTC."
msgstr "Це показуватиме час у вибраному часовому поясі замість UTC. "

#: ../lib/modules/customFields.inc:134 ../lib/modules/customFields.inc:2493
msgid "Validation expression"
msgstr "Вираз для перевірки"

#: ../lib/modules/customFields.inc:135
#, php-format
msgid ""
"Please enter the regular expression (e.g. \"/^[0-9a-zA-Z]+$/\") to validate "
"this field. For a syntax description see <a href=\"%s\">here</a>."
msgstr "Будь ласка, вкажіть регулярний вираз (наприклад, \"/^[0-9a-zA-Z]+$/\") для перевірки цього поля. Для опису синтаксису див.<a href=\"%s\">тут</a>."

#: ../lib/modules/customFields.inc:138 ../lib/modules/customFields.inc:142
#: ../lib/modules/customFields.inc:2497 ../lib/modules/customFields.inc:5548
msgid "Validation message"
msgstr "Повідомлення перевірки"

#: ../lib/modules/customFields.inc:139
msgid ""
"This message is shown when the field value does not match the validation "
"expression."
msgstr "Це повідомлення показується у випадку, якщо значення поля не відповідає виразу перевірки."

#: ../lib/modules/customFields.inc:143
msgid ""
"This message is shown when the field value does not match the format or an "
"required value is not set."
msgstr "Це повідомлення показується у випадку, якщо значення поля не відповідає формату або необхідне значення не встановлено."

#: ../lib/modules/customFields.inc:146 ../lib/modules/customFields.inc:3758
msgid "Value for \"checked\""
msgstr "Значення для \"відмічено\""

#: ../lib/modules/customFields.inc:147
msgid ""
"This is the LDAP attribute's value that puts the checkbox in an activated "
"state. The value is case-insensitive."
msgstr "Це значення атрибута LDAP, при якому чекбокс буде включено. Значення регістронезалежне."

#: ../lib/modules/customFields.inc:150 ../lib/modules/customFields.inc:3763
msgid "Value for \"unchecked\""
msgstr "Значення для \"скинуто\""

#: ../lib/modules/customFields.inc:151
msgid ""
"This is the LDAP attribute's value that puts the checkbox in an deactivated "
"state. The value is case-insensitive."
msgstr "Це значення атрибута LDAP, при якому чекбокс буде виключено. Значення регістронезалежне."

#: ../lib/modules/customFields.inc:155
msgid ""
"If the LDAP attribute has no value then the checkbox is set to this value."
msgstr "Якщо у атрибута LDAP відсутнє значення, тоді чекбокс приймає це значення."

#: ../lib/modules/customFields.inc:159
msgid "Number of columns in text area."
msgstr "Кількість колонок в текстовій області."

#: ../lib/modules/customFields.inc:162 ../lib/modules/customFields.inc:3605
msgid "Rows"
msgstr "Рядки"

#: ../lib/modules/customFields.inc:163
msgid "Number of rows in text area."
msgstr "Кількість рядків у текстовій області."

#: ../lib/modules/customFields.inc:166 ../lib/modules/customFields.inc:3407
#: ../lib/modules/simpleSecurityObject.inc:77
#: ../lib/modules/simpleSecurityObject.inc:109
#: ../lib/modules/simpleSecurityObject.inc:311
#: ../lib/modules/inetOrgPerson.inc:764 ../lib/modules/inetOrgPerson.inc:3648
#: ../lib/modules/posixAccount.inc:204 ../lib/modules/posixAccount.inc:356
#: ../lib/modules/posixAccount.inc:2473 ../lib/modules/posixGroup.inc:425
#: ../lib/modules/posixGroup.inc:517
msgid "Password hash type"
msgstr "Тип хеша пароля"

#: ../lib/modules/customFields.inc:167
#: ../lib/modules/simpleSecurityObject.inc:110
#: ../lib/modules/inetOrgPerson.inc:765 ../lib/modules/posixAccount.inc:357
#: ../lib/modules/posixGroup.inc:426
msgid ""
"LAM supports a large number of possibilities to generate the hash value of "
"passwords. CRYPT-SHA512 and SSHA are the most common. We do not recommend to"
" use plain text passwords unless passwords are hashed server-side."
msgstr "LAM підтримує велику кількість можливостей генерувати хеш-значення паролів. CRYPT-SHA512 та SSHA є найбільш поширеними. Ми не рекомендуємо використовувати паролі простого тексту, якщо паролі не хешовані на стороні сервера. "

#: ../lib/modules/customFields.inc:170 ../lib/modules/customFields.inc:3993
msgid "Value mapping"
msgstr "Відповідність значення"

#: ../lib/modules/customFields.inc:171
msgid ""
"Please specify the possible values for this field. Each value can have a "
"descriptive label that is displayed to the user."
msgstr "Будь ласка, вкажіть можливі значення для цього поля. Кожне значення може мати мітку-опис, яка буде показана користувачу."

#: ../lib/modules/customFields.inc:174 ../lib/modules/customFields.inc:178
#: ../lib/modules/customFields.inc:2503 ../lib/modules/customFields.inc:2581
#: ../lib/modules/customFields.inc:2590 ../lib/modules/customFields.inc:4214
#: ../lib/modules/customFields.inc:4248 ../lib/modules/customFields.inc:4252
#: ../lib/modules/customFields.inc:4459 ../lib/modules/customFields.inc:5540
msgid "Allow multiple values"
msgstr "Дозволити багато значень"

#: ../lib/modules/customFields.inc:175
msgid "Allows to select multiple values from the list."
msgstr "Дозволяє вибирати багато значень з цього списку."

#: ../lib/modules/customFields.inc:175 ../lib/modules/customFields.inc:179
msgid ""
"You can select the minimum and maximum number of values that are required."
msgstr "Ви можете вибрати мінімальну та максимальну кількість необхідних значень."

#: ../lib/modules/customFields.inc:179
msgid "Allows to enter multiple values for this attribute."
msgstr "Дозволяє вказувати багато значень для цього атрибута."

#: ../lib/modules/customFields.inc:182 ../lib/modules/customFields.inc:2515
msgid "Auto-completion"
msgstr "Авто-завершення"

#: ../lib/modules/customFields.inc:183
msgid ""
"Enables auto-completion for this field. All existing values of this "
"attribute will be offered as auto-complete values."
msgstr "Включає авто-завершення для всіх полів. Всі існуючі записи цього атрибута будуть пропонуватися як варіанти авто-завершення."

#: ../lib/modules/customFields.inc:186 ../lib/modules/customFields.inc:4703
msgid "Maximum file size"
msgstr "Максимальний розмір файлу"

#: ../lib/modules/customFields.inc:187
msgid "Specifies the maximum allowed file size in bytes."
msgstr "Вказує максимально можливий розмір файлу в байтах."

#: ../lib/modules/customFields.inc:190 ../lib/modules/customFields.inc:4699
msgid "File extension"
msgstr "Розширення файлу"

#: ../lib/modules/customFields.inc:191
msgid "Specifies the allowed file extension. This is checked at upload time."
msgstr "Вказує допустиме розширення файлу. Це перевіряється під час завантаження файлу."

#: ../lib/modules/customFields.inc:194 ../lib/modules/customFields.inc:4771
#: ../lib/modules/customFields.inc:4815 ../lib/modules/ldapPublicKey.inc:178
#: ../lib/modules/ldapPublicKey.inc:384 ../lib/modules/inetOrgPerson.inc:2745
#: ../lib/modules/inetOrgPerson.inc:2875
msgid "Upload a file"
msgstr "Завантажити файл"

#: ../lib/modules/customFields.inc:195
msgid "Here you can upload a new file."
msgstr "Тут ви можете завантажити новий файл."

#: ../lib/modules/customFields.inc:199 ../lib/modules/customScripts.inc:72
msgid "Here you can set a custom display name for this module."
msgstr "Тут ви можете встановити користувацьку назву для цього модуля."

#: ../lib/modules/customFields.inc:202
msgid "Custom icon"
msgstr "Користувацький значок"

#: ../lib/modules/customFields.inc:203
msgid "Here you can set the URL to a custom icon (32x32px) for this module."
msgstr "Тут ви можете встановити URL для користувацького значка (32x32px) цього модуля."

#: ../lib/modules/customFields.inc:206 ../lib/modules/customFields.inc:634
msgid "Display multiple groups as accordion"
msgstr "Показувати кілька груп як об’єднання"

#: ../lib/modules/customFields.inc:207
msgid ""
"If activated then LAM will show an accordion view if there is more than one "
"group per account type."
msgstr "Якщо активовано, то LAM буде показувати об’єднаний перегляд при більш ніж одній групі на тип акаунту."

