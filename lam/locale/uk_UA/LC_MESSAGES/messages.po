#: ../lib/lists.inc:1387 ../help/help.inc:109
msgid "Maximum list entries"
msgstr "Максимальна кількість записів у списку"

#: ../lib/lists.inc:1393
msgid "Show account status"
msgstr "Показати статус акаунта"

#: ../lib/lists.inc:1457
